# Twenty CRM Environment Configuration
# Copy this to .env and customize for your environment

# PostgreSQL Configuration
POSTGRES_USER=twenty
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=twenty

# Redis Configuration
REDIS_URL=redis://redis:6379

# Twenty Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NODE_ENV=development

# Database Connection
DATABASE_URL=postgres://twenty:change-me-in-production@postgres:5432/twenty

# API Configuration
API_URL=http://localhost:3001
API_PORT=3001

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001
FRONTEND_PORT=3000

# Mautic Configuration
MAUTIC_URL=http://localhost:8080
MAUTIC_DB_HOST=postgres
MAUTIC_DB_PORT=5432
MAUTIC_DB_NAME=mautic

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tryverse.com

# Tryverse-Specific Configuration
# Add your custom variables here
TRYVERSE_API_KEY=
TRYVERSE_ENV=development
TRYVERSE_REGION=us-east-1

# Feature Flags
ENABLE_AI_AGENT=true
ENABLE_CUSTOM_FIELDS=true
ENABLE_INTEGRATIONS=true
ENABLE_WEBHOOKS=true
